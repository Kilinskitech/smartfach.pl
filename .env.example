# Katalog zmiennych konfigurowanych w Vercelu. Nie wpisuj tutaj prawdziwych sekretów.
# Publiczny adres danego środowiska bez końcowego ukośnika.
NEXT_PUBLIC_APP_URL=

# Supabase: wartości z Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Wyłącznie serwer. Użyj nowego klucza sb_secret_ i nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Jedyny administrator platformy. Wpisz UUID konta z Supabase Auth po rejestracji.
PLATFORM_ADMIN_USER_ID=
PLATFORM_ADMIN_EMAIL=

# Stripe: klucze i miesięczne ceny recurring z jednego trybu (test albo live).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE=
STRIPE_PRICE_PRO=

# OpenRouter. Nigdy nie wklejaj sekretów do rozmowy ani do frontendu.
OPENROUTER_API_KEY=
# Kolejność modeli jest wersjonowana w kodzie: GPT-5 Nano, potem Gemini Flash Latest.
# true ogranicza routing do endpointów deklarujących Zero Data Retention.
OPENROUTER_REQUIRE_ZDR=true
# true udostępnia modelowi wyszukiwanie aktualnych informacji. Może zwiększać koszt zapytania.
OPENROUTER_WEB_SEARCH=true
# true włącza płatne żądania do API; domyślnie wyłączone.
SMARTFACH_ENABLE_AI=false
